{
  "compilerOptions": {
    "resolveJsonModule": true
  },
  "typeAcquisition": {
    "enable": true,
    "include": [
      "request-promise",
      "redis",
      "fs",
      "lodash",
      "moment",
      "fast-csv",
      "md5",
      "js-sha256",
      "xml2js",
      "secure-random",
      "@turf/turf",
      "@turf/helpers",
      "jsonwebtoken",
      "bluebird",
      "googleapis"
    ]
  },
  "include": [
    "./**/*.js",
    "../../index.d.ts",
    "../../context.json"
  ]
}
